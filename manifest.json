{
  "schemaVersion": 1,
  "id": "wbarakat.trace",
  "name": "Trace",
  "version": "0.2.0",
  "author": "Waleed Barakat",
  "license": "MIT",
  "description": "A keyboard-first Sentry inbox with native triage, project scope, and default-agent handoff.",
  "kinds": ["service", "bar-widget", "panel"],
  "activation": "on-demand",
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml",
    "panel": "App.qml"
  },
  "barWidget": {
    "displayName": "Trace",
    "description": "Triage Sentry issues and hand them to your default agent.",
    "category": "Development",
    "aliases": ["trace", "sentry", "errors", "issues", "production"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300,
      "maxIssues": 50
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 60,
        "max": 3600,
        "step": 60,
        "defaultValue": 300
      },
      {
        "key": "maxIssues",
        "type": "integer",
        "label": "Maximum issues to load",
        "min": 10,
        "max": 100,
        "step": 10,
        "defaultValue": 50
      }
    ]
  }
}
